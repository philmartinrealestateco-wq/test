# Copy to .env and fill in only what you have. Every key is optional:
# the tool runs in keyless mode otherwise.
#
# Values are never printed: the CLI reports only "configured" or "absent".
# Keep this file out of version control (.env is already in .gitignore).

# Etherscan V2 unified API (https://etherscan.io/apis) - serves Ethereum.
# - A free key covers Ethereum (chainid=1) only.
# - BNB Smart Chain (chainid=56) requires a paid Etherscan plan.
ETHERSCAN_API_KEY=

# BscScan key, used for BNB Smart Chain history through Etherscan V2.
# Falls back to ETHERSCAN_API_KEY when empty. BscScan's own API host is gone
# (api.bscscan.com redirects to Etherscan's v2 migration docs).
BSCSCAN_API_KEY=

# Optional Blockchain.com Explorer credential, sent as api_code.
# Leave empty: blockchain.info's rawaddr endpoint works without authentication,
# which is the default path.
BLOCKCHAIN_EXPLORER_API_KEY=

# Solana JSON-RPC endpoint. The public endpoint is heavily rate limited.
# A Helius/QuickNode URL gives you far more headroom.
# Credentials in this URL (path or query) are scrubbed from all output.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# BNB Chain JSON-RPC endpoint used for native balance verification and BEP-20
# contract reads. If this endpoint is unreachable, the provider retries the other
# public dataseeds (bsc-dataseed1.defibit.io, bsc-dataseed1.ninicoin.io).
BSC_RPC_URL=https://bsc-dataseed.binance.org

# BEP-20 balances are checked against an allowlist of contracts (13 major tokens
# by default). This is not full token discovery: that needs a log indexer.
BEP20_ENABLED=true
# Optional CSV of extra contracts: contract[,symbol[,decimals]]
# TOKEN_LIST_FILE=data/tokens.bsc.csv

# Analysis defaults (CLI flags override these).
MIN_USD=50000
MAX_USD=900000
ACTIVITY_DAYS=30

# Degree of parallelism. Each host has its own rate limiter regardless.
MAX_WORKERS=4
REQUEST_TIMEOUT=20
PRICE_CACHE_TTL=300

# Only keyless providers are used when no key is configured.
ALLOW_KEYLESS=true

LOG_LEVEL=INFO
